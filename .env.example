# Environment template — copy to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is gitignored. This file is NOT: it is the only place the required
# variables are written down. If you add a variable the app reads, add it here
# in the same commit.

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

# Required. Prisma Postgres (or any Postgres).
#
# `sslmode=verify-full` is not optional and not a preference.
# `pg` v8 treats `require`, `prefer` and `verify-ca` as aliases for
# `verify-full` (encrypt AND verify the certificate), but `pg` v9 restores real
# libpq semantics, where `require` means "encrypt WITHOUT verifying the
# certificate". Writing `require` is therefore safe today by accident and
# silently becomes vulnerable to a machine-in-the-middle on a dependency bump.
# A missing `sslmode` against a hosted database is worse still: it requests no
# encryption at all.
#
# `src/lib/db/assert-secure-ssl.ts` refuses anything else in production, so a
# wrong value here fails the deploy with the offending mode named.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"

# ─────────────────────────────────────────────────────────────────────────────
# Image provider
# ─────────────────────────────────────────────────────────────────────────────

# Required if you use any image provider other than the Cloudinary default.
# Accepted: `cloudinary` (default) | `s3`
#
# NOTE: this is `IMAGE_PROVIDER`, NOT `NEXT_PUBLIC_IMAGE_PROVIDER`. The
# `NEXT_PUBLIC_` prefix is not read by any code and would silently do nothing.
# Only the `NEXT_PUBLIC_` variables in the section below are exposed to the
# browser; this one stays server-side.
IMAGE_PROVIDER="cloudinary"

# Required for Cloudinary. The API secret is server-side only — never prefix it
# with `NEXT_PUBLIC_`.
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
CLOUDINARY_UPLOAD_PRESET=""

# Required when `IMAGE_PROVIDER=s3`. Ignored by the Cloudinary path.
S3_PUBLIC_BASE_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# Public — inlined into the client bundle at BUILD time
# ─────────────────────────────────────────────────────────────────────────────
#
# Changing any of these requires a rebuild, not just a restart. A value that
# looks right in the dashboard but wrong on the live site is almost always this.

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Built from the cloud name. Used for og:image and other absolute image URLs.
NEXT_PUBLIC_IMAGE_CDN="https://res.cloudinary.com/${NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME}/image/upload"

# Required. The canonical origin, used for metadata, sitemap and share links.
# Set it to the real domain, not the platform preview URL, before going live —
# these are baked into the build and will not follow a later env change.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact and social links rendered in the header, footer and floating actions.
NEXT_PUBLIC_WHATSAPP_PHONE=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_MAPS_URL=""

# Optional. Absent or empty disables the Meta Pixel provider entirely, so
# leaving it unset is a valid way to turn tracking off.
NEXT_PUBLIC_META_PIXEL_ID=""

# ─────────────────────────────────────────────────────────────────────────────
# Auth
# ─────────────────────────────────────────────────────────────────────────────

# Required. Signing key for better-auth sessions and reset tokens. Generate it
# with `openssl rand -base64 32`. Rotating it invalidates every live session.
BETTER_AUTH_SECRET=""

# Required. The canonical origin. Reset and verification links are built from
# it, and better-auth's origin check rejects a callback from anywhere else.
BETTER_AUTH_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# Transactional email (Resend)
# ─────────────────────────────────────────────────────────────────────────────

# Required for password reset and email verification. When absent the app still
# runs -- sends are logged and skipped -- so recovery quietly does nothing.
# That is deliberate: a missing mail provider must never take auth down.
RESEND_API_KEY=""

# Required alongside the key. It must be an address on a domain verified in
# Resend. `onboarding@resend.dev` is the shared test sender: it delivers only to
# the Resend account owner's own inbox, which is fine locally and useless for
# real users.
RESEND_FROM_EMAIL="onboarding@resend.dev"

# Inbox that receives a notice for every inquiry sent from a car page.
# Empty means inquiries are still stored, just not announced.
LEAD_NOTIFICATION_EMAIL=""

# ─────────────────────────────────────────────────────────────────────────────
# Not set by hand
# ─────────────────────────────────────────────────────────────────────────────
#
# `NODE_ENV` is owned by the runtime. `VERCEL_URL` is injected by the platform.
# Do not add either to this file.

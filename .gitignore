/node_modules
/.next/
/out/
/build
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.env*
# ...but the template must be versioned. Without this negation `.env*` also
# matches `.env.example`, and the one file that documents the required variables
# would be invisible to git — which is the exact failure it exists to prevent.
!.env.example
.vercel
.atl/
*.tsbuildinfo
next-env.d.ts

# Prisma generated client (Prisma 7 writes it here instead of node_modules)
/prisma/generated/
.claude
.agents
# Local CodeGraph index. It is machine-specific and rebuilt by the tool, so it
# must never be committed or shared between checkouts.
.codegraph/
skills-lock.json
# generated by pnpm sweep:orphans
orphan-sweep-report*

    "dotenv": "^16.6.1",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "husky": "^9.1.7",
    "jsdom": "25.0.0",
    "lint-staged": "^17.5.1",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.1",
    "prisma": "6.17.1",

{
  "name": "car-agency-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm lint:fix && pnpm format",
    "check": "pnpm format:check && pnpm lint",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:changed": "vitest run --changed",
    "test:contract": "vitest run src/modules/image-uploads/tests/cloudinary-contract.test.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "remove-comments": "node src/scripts/remove-comments.mjs && pnpm format",
    "sweep:orphans": "tsx scripts/sweep-orphan-images.ts",
    "publications": "tsx scripts/publications.ts",
    "drain:jobs": "tsx scripts/drain-jobs.ts",
    "rotate:tokens": "tsx scripts/rotate-tokens.ts"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx,css,md,mdx,html,json,jsonc,yml,yaml,graphql}": [
      "prettier --check --ignore-unknown"
    ]
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/analytics": "1.6.1",
    "@vercel/speed-insights": "2.0.0",
    "bcryptjs": "3.0.3",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.8.0",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "lucide-react": "0.563.0",
    "next": "16.3.6",
    "next-cloudinary": "6.17.5",
    "pg": "8.23.0",
    "qrcode.react": "4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.66.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "resend": "6.34.1",
    "slugify": "1.6.6",
    "sonner": "2.0.7",
    "tailwind-merge": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@tailwindcss/postcss": "4.1.18",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "dotenv": "16.6.1",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jsdom": "25.0.0",
    "lint-staged": "17.5.1",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "0.7.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.1.18",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.55.0",
    "vitest": "3.2.7"
  }
}

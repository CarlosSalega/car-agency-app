    "@vercel/speed-insights": "2.0.0",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "cloudinary": "2.8.0",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "geist": "1.5.1",
    "lucide-react": "0.563.0",
    "next": "15.5.25",

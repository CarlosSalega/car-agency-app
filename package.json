{
  "name": "car-agency-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fix": "pnpm lint:fix && pnpm format",
    "check": "pnpm format:check && pnpm lint",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "remove-comments": "node src/scripts/remove-comments.mjs && pnpm format"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,jsx,css,md,mdx,html,json,jsonc,yml,yaml,graphql}": [
      "prettier --check --ignore-unknown"
    ]
  },

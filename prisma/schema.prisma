generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COLLABORATOR
}

enum CarType {
  SUV
  SEDAN
  HATCHBACK
  PICKUP
  COUPE
  // Argentinian market term: "Furgón". Values stay in English like the rest.
  VAN
}

enum CarStatus {
  AVAILABLE
  BY_APPOINTMENT
  RESERVED
  SOLD
  INACTIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  NEGOTIATING
  WON
  LOST
}

enum FuelType {
  GASOLINE
  DIESEL
  CNG
  HYBRID
  ELECTRIC
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum Currency {
  ARS
  USD
}

enum PaymentMethod {
  CONTADO
  BNA_MAS
  CREDITO_PRENDARIO
  TARJETA_CREDITO
  PERMUTA
}

enum LinkTreeCategory {
  CONTACT
  SOCIAL
}

/// Where a vehicle can be published besides our own site (S2). Mercado Libre
/// first (S5); the socials come later and are listed so the model does not need
/// a migration to grow.
enum Channel {
  MERCADOLIBRE
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

/// `CONNECTED` is usable, `EXPIRED` needs a refresh and `REVOKED` needs a human:
/// a token that cannot be decrypted (D2) or that the marketplace rejected.
enum ChannelAccountStatus {
  CONNECTED
  EXPIRED
  REVOKED
}

/// The lifecycle of one vehicle on one channel.
///
/// `DIVERGED` is the state D1 exists for: the remote value no longer matches
/// `syncedSnapshot`, and only a human chooses which side wins.
enum PublicationState {
  DRAFT
  PUBLISHING
  PUBLISHED
  OUTDATED
  DIVERGED
  PAUSED
  REMOVED
  FAILED
}

/// The lifecycle of one background job.
///
/// `RETRYING` is not a state: a job that will run again is `PENDING` with an
/// incremented `attempts` and a later `runAt`, because one query answers "what
/// can I claim now". `DEAD` is terminal for a human's attention, not for the
/// drainer: the queue never picks it up again.
enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

/// One deferred unit of work, claimed by a drainer.
///
/// The queue is a table instead of an in-process array because the work it
/// carries (publishing a vehicle to a marketplace) outlives a request and must
/// survive a deploy. Claiming is a compare-and-set so two drainers running at
/// once cannot both own the same row.
///
/// `idempotencyKey` is unique on purpose: the same logical operation enqueued
/// twice is one row, so a retried request cannot publish a vehicle twice.
/// History lives on this row (`attempts`, `lastError`, the timestamps) and not
/// in `PublicationEvent`, which traces a publication, not a job.
model Job {
  id             String    @id @default(uuid())
  kind           String
  idempotencyKey String    @unique
  payload        Json?
  status         JobStatus @default(PENDING)
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  /// Earliest moment a drainer may claim this job.
  runAt          DateTime
  /// Set when claimed, cleared when the job reaches a terminal state.
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Serves the claim query exactly: `status` equality, then `runAt` range.
  @@index([status, runAt])
}

// Auth models follow better-auth's canonical shape. They are not Auth.js
// models: passwords live on `Account.password` with `providerId: "credential"`
// and `accountId` equal to the user id. Without that row, email+password
// sign-in fails. See `src/lib/auth/server.ts`.
model User {
  id               String      @id @default(uuid())
  name             String?
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  role             Role        @default(COLLABORATOR)
  isActive         Boolean     @default(true)
  twoFactorEnabled Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  accounts         Account[]
  sessions         Session[]
  twoFactors       TwoFactor[]
  cars             Car[]       @relation("UserCars")
  imageUploads     ImageUpload[]
  logs             Log[]
  createdBrands    Brand[]     @relation("UserBrands")
  createdModels    Model[]     @relation("UserModels")
  createdSellers   Seller[]    @relation("UserSellers")
}

// Added by the better-auth `twoFactor` plugin, not declared in
// `additionalFields`: the plugin owns the field and its schema. It is the
// switch the sign-in hook reads to decide whether a password alone is enough.
model TwoFactor {
  id                      String    @id @default(uuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  models      Model[]
  cars        Car[]
  createdById String
  createdBy   User     @relation("UserBrands", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Model {
  id          String   @id @default(uuid())
  name        String
  brand       Brand    @relation(fields: [brandId], references: [id])
  brandId     String
  cars        Car[]
  createdById String
  createdBy   User     @relation("UserModels", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, brandId])
}

model Seller {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  phone       String   @unique
  email       String?  @unique
  isActive    Boolean  @default(true)
  cars        Car[]
  leads       Lead[]
  createdById String
  createdBy   User     @relation("UserSellers", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([createdById])
}

model Car {
  id             String          @id @default(uuid())
  title          String
  slug           String          @unique
  brandId        String
  brand          Brand           @relation(fields: [brandId], references: [id])
  modelId        String
  model          Model           @relation(fields: [modelId], references: [id])
  sellerId       String?
  seller         Seller?         @relation(fields: [sellerId], references: [id])
  year           Int
  kilometers     Int
  type           CarType
  fuelType       FuelType
  transmission   Transmission
  currency       Currency        @default(ARS)
  images         String[]
  status         CarStatus       @default(AVAILABLE)
  showBadge      Boolean         @default(false)
  paymentMethods PaymentMethod[] @default([])
  price          Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  version        String?
  color          String?
  patent         String?         @unique
  description    String?
  soldAt         DateTime?
  deletedAt      DateTime?
  userId         String?
  user           User?           @relation("UserCars", fields: [userId], references: [id])
  visits         Visit[]
  leads          Lead[]
  publications   Publication[]

  @@index([userId])
  @@index([status])
  @@index([brandId])
  @@index([modelId])
  @@index([sellerId])
}

/// One stored image and the user whose upload created it.
///
/// The row describes an upload, not an ownership transfer: assets stay keyed by
/// their storage key and a key listed by a car is authorised by that car. This
/// record only lets the uploader clean up an image nobody attached to a
/// vehicle.
model ImageUpload {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Log {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Visit {
  id        String   @id @default(uuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
}

model LinkTreeLink {
  id        String           @id @default(uuid())
  category  LinkTreeCategory
  label     String
  href      String
  iconKey   String?
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([category, isActive, sortOrder])
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// An inquiry from the public site. Rows are created by an unauthenticated
/// endpoint, so the route validates before writing; the columns here are the
/// contract, not the validation.
model Lead {
  id        String     @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String?
  status    LeadStatus @default(NEW)
  /// The page on our own site that produced the inquiry (the POST referer).
  source    String?
  /// First-touch attribution. These are separate columns instead of a packed
  /// string because T1.6 groups by channel: parsing a blob in every query is
  /// the debt that compounds. All nullable, because most visitors arrive with
  /// no campaign at all.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /// The external site that brought the visitor, when the browser sent one.
  referrer    String?
  /// Consent to be contacted, recorded when it was given. Personal data under
  /// Ley 25.326, so the timestamp is part of the record, not an afterthought.
  consentAt DateTime?
  /// Internal notes written by staff, never shown publicly.
  notes     String?
  carId     String?
  car       Car?       @relation(fields: [carId], references: [id], onDelete: SetNull)
  sellerId  String?
  seller    Seller?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([carId])
  @@index([createdAt])
  @@index([sellerId])
  @@index([utmSource])
}

/// The linked Mercado Libre seller account.
///
/// Credentials live here and not in the generic `Settings` key/value table on
/// purpose: that table has a listing API, and an access token must never be able
/// to leak through a screen that renders "all settings".
///
/// Tokens are sealed with AES-256-GCM before they reach this table, so a database
/// dump alone is not enough to publish on the dealership's behalf.
model MeliAccount {
  id           String   @id @default(uuid())
  /// ML's own user id, unique so re-linking an account replaces the old row.
  meliUserId   String   @unique
  nickname     String
  siteId       String?
  /// Sealed, never plaintext.
  accessToken  String
  /// Sealed, and single-use: Mercado Libre returns a new one on every refresh.
  refreshToken String
  expiresAt    DateTime
  scope        String?
  linkedById   String?
  linkedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// The credential set for one marketplace or social account.
///
/// Tokens are sealed with AES-256-GCM before they reach this table (D2), so a
/// dump alone does not let anyone publish as the agency. `status` records what
/// the last attempt found: a token that cannot be decrypted marks the account
/// `REVOKED` and asks for a reconnect instead of retrying forever.
model ChannelAccount {
  id           String               @id @default(uuid())
  channel      Channel
  /// The account's own id on that platform, unique per channel so re-linking
  /// replaces the row instead of leaving two candidates for the sync.
  remoteUserId String
  /// Sealed, never plaintext.
  accessToken  String
  /// Sealed, and single-use where the platform says so (Mercado Libre).
  refreshToken String
  expiresAt    DateTime
  status       ChannelAccountStatus @default(CONNECTED)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  publications Publication[]

  @@unique([channel, remoteUserId])
}

/// One vehicle on one channel.
///
/// Merging the writable fields into a single record per vehicle means the panel
/// can answer "where is this published and is it up to date" with one query,
/// even when two channels sit behind the same account.
model Publication {
  id              String           @id @default(uuid())
  carId           String
  car             Car              @relation(fields: [carId], references: [id], onDelete: Cascade)
  channel         Channel
  accountId       String
  account         ChannelAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// The marketplace's own id, e.g. an ML item id. Null until the first publish,
  /// and replaced (not kept) when a relist returns a new one.
  remoteId        String?
  state           PublicationState @default(DRAFT)
  /// Remote status and sub-status verbatim. Mapping them onto `state` loses
  /// information: `paused` plus `picture downloading pending` is transient and
  /// resolves itself, which is not the same as a pause a human caused.
  remoteStatus    String?
  remoteSubStatus String?
  /// What we last sent: price, title, status, picture count. Without it the app
  /// cannot tell "the remote site differs because someone edited it" from "we
  /// have not pushed yet" (D1).
  syncedSnapshot  Json?
  syncedAt        DateTime?
  lastError       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  events          PublicationEvent[]

  @@unique([carId, channel, accountId])
  @@index([state])
}

/// An append-only trace of what happened to a publication.
///
/// Kept separate from `Publication` so the record of a failure survives the
/// retry that overwrote `lastError`.
model PublicationEvent {
  id            String      @id @default(uuid())
  publicationId String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  /// Short verb-like label, e.g. `create`, `price-update`, `pause`.
  kind          String
  payload       Json?
  createdAt     DateTime    @default(now())

  @@index([publicationId, createdAt])
}

/// The required attribute set of one Mercado Libre category, as fetched.
///
/// The set is a fact owned by the marketplace, not by us: `MLA1744` asks for
/// BRAND, MODEL, TRIM and VEHICLE_YEAR today, and Mercado Libre can make another
/// attribute mandatory without telling anyone. A hand-written table would rot
/// silently and turn into a publish that fails with an opaque error, so it is
/// discovered at runtime and cached here.
///
/// `fetchedAt` is the only defence against a stale set — there is no change
/// feed to subscribe to — so the reader refetches once it is older than the TTL.
/// One row per category id, which is the marketplace's own primary key.
model CategoryAttributeCache {
  categoryId String   @id
  /// The required attributes, as `{ id, name, valueType }` objects.
  attributes Json
  fetchedAt  DateTime
}

/// A customer testimonial shown on the landing.
///
/// Kept in the database instead of the component because the quotes were
/// hardcoded: publishing a new one required a deploy, and a rename could leave
/// the old brand name frozen inside a customer's words forever.
///
/// `isPublished` defaults to **false** on purpose. A row that appears is a
/// deliberate act; staff load what Google already has, then publish it, and the
/// public query never sees a half-finished entry.
model Review {
  id         String  @id @default(uuid())
  /// The name printed on the card, exactly as the customer signs it.
  authorName String
  /// 1..5 whole stars. Validated in the application layer, not with a check
  /// constraint, because `db push` has to stay repeatable.
  rating     Int
  /// Verbatim, including the emoji and the line breaks.
  text       String
  /// When the customer wrote it. The "hace 3 meses" label is derived from this
  /// at render time: a stored phrase would be wrong a month later.
  reviewedAt DateTime
  /// Repository path such as `/reviews/norma-sonez.webp`, or null for a review
  /// whose author has no photo. Never an external URL: the public assets sweep
  /// in `src/__tests__/public-assets.test.ts` only covers what we serve.
  photoPath  String?
  /// Manual display order. Reviews with the same value fall back to newest
  /// first, so an untouched row still lands in a sane place.
  sortOrder  Int     @default(0)
  isPublished Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isPublished, sortOrder])
}

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COLLABORATOR
}

enum CarType {
  SUV
  SEDAN
  HATCHBACK
  PICKUP
  COUPE
  // Argentinian market term: "Furgón". Values stay in English like the rest.
  VAN
}

enum CarStatus {
  AVAILABLE
  BY_APPOINTMENT
  RESERVED
  SOLD
  INACTIVE
}

enum FuelType {
  GASOLINE
  DIESEL
  CNG
  HYBRID
  ELECTRIC
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum Currency {
  ARS
  USD
}

enum PaymentMethod {
  CONTADO
  BNA_MAS
  CREDITO_PRENDARIO
  TARJETA_CREDITO
  PERMUTA
}

enum LinkTreeCategory {
  CONTACT
  SOCIAL
}

// Auth models follow better-auth's canonical shape. They are not Auth.js
// models: passwords live on `Account.password` with `providerId: "credential"`
// and `accountId` equal to the user id. Without that row, email+password
// sign-in fails. See `src/lib/auth/server.ts`.
model User {
  id               String      @id @default(uuid())
  name             String?
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  role             Role        @default(COLLABORATOR)
  isActive         Boolean     @default(true)
  twoFactorEnabled Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  accounts         Account[]
  sessions         Session[]
  twoFactors       TwoFactor[]
  cars             Car[]       @relation("UserCars")
  logs             Log[]
  createdBrands    Brand[]     @relation("UserBrands")
  createdModels    Model[]     @relation("UserModels")
  createdSellers   Seller[]    @relation("UserSellers")
}

// Added by the better-auth `twoFactor` plugin, not declared in
// `additionalFields`: the plugin owns the field and its schema. It is the
// switch the sign-in hook reads to decide whether a password alone is enough.
model TwoFactor {
  id                      String    @id @default(uuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  models      Model[]
  cars        Car[]
  createdById String
  createdBy   User     @relation("UserBrands", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Model {
  id          String   @id @default(uuid())
  name        String
  brand       Brand    @relation(fields: [brandId], references: [id])
  brandId     String
  cars        Car[]
  createdById String
  createdBy   User     @relation("UserModels", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, brandId])
}

model Seller {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  phone       String   @unique
  email       String?  @unique
  isActive    Boolean  @default(true)
  cars        Car[]
  createdById String
  createdBy   User     @relation("UserSellers", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([createdById])
}

model Car {
  id             String          @id @default(uuid())
  title          String
  slug           String          @unique
  brandId        String
  brand          Brand           @relation(fields: [brandId], references: [id])
  modelId        String
  model          Model           @relation(fields: [modelId], references: [id])
  sellerId       String?
  seller         Seller?         @relation(fields: [sellerId], references: [id])
  year           Int
  kilometers     Int
  type           CarType
  fuelType       FuelType
  transmission   Transmission
  currency       Currency        @default(ARS)
  images         String[]
  status         CarStatus       @default(AVAILABLE)
  showBadge      Boolean         @default(false)
  paymentMethods PaymentMethod[] @default([])
  price          Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  version        String?
  color          String?
  patent         String?         @unique
  description    String?
  soldAt         DateTime?
  deletedAt      DateTime?
  userId         String?
  user           User?           @relation("UserCars", fields: [userId], references: [id])
  visits         Visit[]

  @@index([userId])
  @@index([status])
  @@index([brandId])
  @@index([modelId])
  @@index([sellerId])
}

model Log {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Visit {
  id        String   @id @default(uuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
}

model LinkTreeLink {
  id        String           @id @default(uuid())
  category  LinkTreeCategory
  label     String
  href      String
  iconKey   String?
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([category, isActive, sortOrder])
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

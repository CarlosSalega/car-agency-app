generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  COLLABORATOR
}

enum CarType {
  SUV
  SEDAN
  HATCHBACK
  PICKUP
  COUPE
  // Argentinian market term: "Furgón". Values stay in English like the rest.
  VAN
}

enum CarStatus {
  AVAILABLE
  BY_APPOINTMENT
  RESERVED
  SOLD
  INACTIVE
}

enum LeadStatus {
  NEW
  CONTACTED
  NEGOTIATING
  WON
  LOST
}

enum FuelType {
  GASOLINE
  DIESEL
  CNG
  HYBRID
  ELECTRIC
  OTHER
}

enum Transmission {
  MANUAL
  AUTOMATIC
}

enum Currency {
  ARS
  USD
}

enum PaymentMethod {
  CONTADO
  BNA_MAS
  CREDITO_PRENDARIO
  TARJETA_CREDITO
  PERMUTA
}

enum LinkTreeCategory {
  CONTACT
  SOCIAL
}

// Auth models follow better-auth's canonical shape. They are not Auth.js
// models: passwords live on `Account.password` with `providerId: "credential"`
// and `accountId` equal to the user id. Without that row, email+password
// sign-in fails. See `src/lib/auth/server.ts`.
model User {
  id               String      @id @default(uuid())
  name             String?
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  role             Role        @default(COLLABORATOR)
  isActive         Boolean     @default(true)
  twoFactorEnabled Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  accounts         Account[]
  sessions         Session[]
  twoFactors       TwoFactor[]
  cars             Car[]       @relation("UserCars")
  logs             Log[]
  createdBrands    Brand[]     @relation("UserBrands")
  createdModels    Model[]     @relation("UserModels")
  createdSellers   Seller[]    @relation("UserSellers")
}

// Added by the better-auth `twoFactor` plugin, not declared in
// `additionalFields`: the plugin owns the field and its schema. It is the
// switch the sign-in hook reads to decide whether a password alone is enough.
model TwoFactor {
  id                      String    @id @default(uuid())
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([secret])
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Brand {
  id          String   @id @default(uuid())
  name        String   @unique
  models      Model[]
  cars        Car[]
  createdById String
  createdBy   User     @relation("UserBrands", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Model {
  id          String   @id @default(uuid())
  name        String
  brand       Brand    @relation(fields: [brandId], references: [id])
  brandId     String
  cars        Car[]
  createdById String
  createdBy   User     @relation("UserModels", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, brandId])
}

model Seller {
  id          String   @id @default(uuid())
  firstName   String
  lastName    String
  phone       String   @unique
  email       String?  @unique
  isActive    Boolean  @default(true)
  cars        Car[]
  leads       Lead[]
  createdById String
  createdBy   User     @relation("UserSellers", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([createdById])
}

model Car {
  id             String          @id @default(uuid())
  title          String
  slug           String          @unique
  brandId        String
  brand          Brand           @relation(fields: [brandId], references: [id])
  modelId        String
  model          Model           @relation(fields: [modelId], references: [id])
  sellerId       String?
  seller         Seller?         @relation(fields: [sellerId], references: [id])
  year           Int
  kilometers     Int
  type           CarType
  fuelType       FuelType
  transmission   Transmission
  currency       Currency        @default(ARS)
  images         String[]
  status         CarStatus       @default(AVAILABLE)
  showBadge      Boolean         @default(false)
  paymentMethods PaymentMethod[] @default([])
  price          Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  version        String?
  color          String?
  patent         String?         @unique
  description    String?
  soldAt         DateTime?
  deletedAt      DateTime?
  userId         String?
  user           User?           @relation("UserCars", fields: [userId], references: [id])
  visits         Visit[]
  leads          Lead[]

  @@index([userId])
  @@index([status])
  @@index([brandId])
  @@index([modelId])
  @@index([sellerId])
}

model Log {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  metadata  String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model Visit {
  id        String   @id @default(uuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id])
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?
}

model LinkTreeLink {
  id        String           @id @default(uuid())
  category  LinkTreeCategory
  label     String
  href      String
  iconKey   String?
  sortOrder Int              @default(0)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([category, isActive, sortOrder])
}

model Settings {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// An inquiry from the public site. Rows are created by an unauthenticated
/// endpoint, so the route validates before writing; the columns here are the
/// contract, not the validation.
model Lead {
  id        String     @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String?
  status    LeadStatus @default(NEW)
  /// The page on our own site that produced the inquiry (the POST referer).
  source    String?
  /// First-touch attribution. These are separate columns instead of a packed
  /// string because T1.6 groups by channel: parsing a blob in every query is
  /// the debt that compounds. All nullable, because most visitors arrive with
  /// no campaign at all.
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  /// The external site that brought the visitor, when the browser sent one.
  referrer    String?
  /// Consent to be contacted, recorded when it was given. Personal data under
  /// Ley 25.326, so the timestamp is part of the record, not an afterthought.
  consentAt DateTime?
  /// Internal notes written by staff, never shown publicly.
  notes     String?
  carId     String?
  car       Car?       @relation(fields: [carId], references: [id], onDelete: SetNull)
  sellerId  String?
  seller    Seller?    @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status])
  @@index([carId])
  @@index([createdAt])
  @@index([sellerId])
  @@index([utmSource])
}

/// The linked Mercado Libre seller account.
///
/// Credentials live here and not in the generic `Settings` key/value table on
/// purpose: that table has a listing API, and an access token must never be able
/// to leak through a screen that renders "all settings".
///
/// Tokens are sealed with AES-256-GCM before they reach this table, so a database
/// dump alone is not enough to publish on the dealership's behalf.
model MeliAccount {
  id           String   @id @default(uuid())
  /// ML's own user id, unique so re-linking an account replaces the old row.
  meliUserId   String   @unique
  nickname     String
  siteId       String?
  /// Sealed, never plaintext.
  accessToken  String
  /// Sealed, and single-use: Mercado Libre returns a new one on every refresh.
  refreshToken String
  expiresAt    DateTime
  scope        String?
  linkedById   String?
  linkedAt     DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
